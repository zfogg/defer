include_guard(GLOBAL)

option(RECAST_AUTO_DOWNLOAD_LLVM_DEV "Download the Windows LLVM development archive when it is unavailable" ON)

# Locate the host libraries used by the native defer tool. The Windows archive
# contains only the headers and libraries needed for this tool; it does not
# provide a complete LLVM CMake package.
function(recast_find_llvm_development)
    if(TARGET recast-llvm-support AND TARGET recast-libclang)
        return()
    endif()
    set(_root "${RECAST_LLVM_DEV_ROOT}")
    if(NOT _root AND DEFINED ENV{RECAST_LLVM_DEV_ROOT})
        set(_root "$ENV{RECAST_LLVM_DEV_ROOT}")
    endif()
    if(RECAST_STATIC_LIBCLANG)
        if(NOT CMAKE_C_COMPILER_LOADED)
            enable_language(C)
        endif()
        if(NOT _root)
            message(FATAL_ERROR "RECAST_STATIC_LIBCLANG requires RECAST_LLVM_DEV_ROOT with LLVM and Clang CMake packages")
        endif()
        find_package(LLVM REQUIRED CONFIG PATHS "${_root}/lib/cmake/llvm" NO_DEFAULT_PATH)
        if(LLVM_PACKAGE_VERSION VERSION_LESS 19)
            message(FATAL_ERROR "LLVM 19 or newer is required; found ${LLVM_PACKAGE_VERSION}")
        endif()
        find_package(Clang REQUIRED CONFIG PATHS "${_root}/lib/cmake/clang" NO_DEFAULT_PATH)
        if(TARGET libclang_static)
            set(_clang_static_target libclang_static)
        elseif(TARGET libclang)
            get_target_property(_clang_type libclang TYPE)
            if(NOT _clang_type STREQUAL "STATIC_LIBRARY")
                message(FATAL_ERROR "LLVM package does not contain a static libclang target")
            endif()
            set(_clang_static_target libclang)
        else()
            message(FATAL_ERROR "LLVM package does not export a static libclang target")
        endif()
        add_library(recast-llvm-support INTERFACE IMPORTED GLOBAL)
        set_property(TARGET recast-llvm-support PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${LLVM_INCLUDE_DIRS};${CLANG_INCLUDE_DIRS}")
        set_property(TARGET recast-llvm-support PROPERTY INTERFACE_LINK_LIBRARIES LLVMSupport)
        set_property(TARGET recast-llvm-support PROPERTY INTERFACE_COMPILE_DEFINITIONS "CINDEX_NO_EXPORTS;RECAST_STATIC_LIBCLANG")
        if(NOT LLVM_ENABLE_RTTI AND NOT MSVC)
            set_property(TARGET recast-llvm-support PROPERTY INTERFACE_COMPILE_OPTIONS "-fno-rtti")
        endif()
        add_library(recast-libclang INTERFACE IMPORTED GLOBAL)
        set_property(TARGET recast-libclang PROPERTY INTERFACE_LINK_LIBRARIES "${_clang_static_target}")
        return()
    endif()
    if(CMAKE_HOST_WIN32)
        if(NOT _root)
            if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$")
                set(_suffix "-aarch64")
            else()
                set(_suffix "")
            endif()
            set(_root "${CMAKE_SOURCE_DIR}/.deps-cache/llvm-dev-23.1.3${_suffix}")
            if(RECAST_AUTO_DOWNLOAD_LLVM_DEV AND NOT EXISTS "${_root}/include/llvm/Support/CommandLine.h")
                if(_suffix STREQUAL "-aarch64")
                    set(_llvm_archive_arch "aarch64")
                else()
                    set(_llvm_archive_arch "x86_64")
                endif()
                set(_llvm_version "23.1.5")
                set(_llvm_archive_name "clang+llvm-${_llvm_version}-${_llvm_archive_arch}-pc-windows-msvc.tar.xz")
                set(_llvm_cache_root "${ASCIICHAT_DEPS_CACHE_DIR}/llvm-dev")
                set(_llvm_archive "${_llvm_cache_root}/${_llvm_archive_name}")
                set(_llvm_download_root "${_llvm_cache_root}/llvm-dev-${_llvm_version}${_suffix}")
                set(_llvm_extracted_root "${_llvm_cache_root}/clang+llvm-${_llvm_version}-${_llvm_archive_arch}-pc-windows-msvc")
                file(MAKE_DIRECTORY "${_llvm_cache_root}")
                if(NOT EXISTS "${_llvm_extracted_root}/include/llvm/Support/CommandLine.h")
                    message(STATUS "Recast LLVM development archive not found; downloading ${_llvm_archive_name}")
                    file(DOWNLOAD
                        "https://github.com/llvm/llvm-project/releases/download/llvmorg-${_llvm_version}/${_llvm_archive_name}"
                        "${_llvm_archive}"
                        SHOW_PROGRESS
                        STATUS _llvm_download_status
                        INACTIVITY_TIMEOUT 60
                        TIMEOUT 1800)
                    list(GET _llvm_download_status 0 _llvm_download_code)
                    list(GET _llvm_download_status 1 _llvm_download_message)
                    if(NOT _llvm_download_code EQUAL 0)
                        message(FATAL_ERROR "Could not download the Recast LLVM development archive: ${_llvm_download_message}")
                    endif()
                    execute_process(
                        COMMAND "${CMAKE_COMMAND}" -E tar xf "${_llvm_archive}"
                        WORKING_DIRECTORY "${_llvm_cache_root}"
                        RESULT_VARIABLE _llvm_extract_result)
                    if(NOT _llvm_extract_result EQUAL 0)
                        message(FATAL_ERROR "Could not extract the Recast LLVM development archive; remove ${_llvm_archive} and retry")
                    endif()
                endif()
                if(NOT EXISTS "${_llvm_extracted_root}/include/llvm/Support/CommandLine.h")
                    message(FATAL_ERROR "Could not locate the extracted Recast LLVM development archive")
                endif()
                file(RENAME "${_llvm_extracted_root}" "${_root}")
            endif()
        endif()
        foreach(_key _llvm_include _clang_include _llvm_support _llvm_demangle _clang_library _clang_runtime)
            unset(${_key} CACHE)
        endforeach()
        find_path(_llvm_include llvm/Support/CommandLine.h PATHS "${_root}/include" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
        find_path(_clang_include clang-c/Index.h PATHS "${_root}/include" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
        find_library(_llvm_support NAMES LLVMSupport PATHS "${_root}/lib" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
        find_library(_llvm_demangle NAMES LLVMDemangle PATHS "${_root}/lib" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
        find_library(_clang_library NAMES libclang clang PATHS "${_root}/lib" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
        find_file(_clang_runtime NAMES libclang.dll PATHS "${_root}/bin" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
        add_library(recast-llvm-support INTERFACE IMPORTED GLOBAL)
        set_property(TARGET recast-llvm-support PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_llvm_include}")
        set_property(TARGET recast-llvm-support PROPERTY INTERFACE_LINK_LIBRARIES
            "${_llvm_support};${_llvm_demangle};advapi32;shell32;ole32;version;ws2_32;dbghelp;bcrypt;ntdll")
        add_library(recast-libclang SHARED IMPORTED GLOBAL)
        set_target_properties(recast-libclang PROPERTIES IMPORTED_IMPLIB "${_clang_library}"
            IMPORTED_LOCATION "${_clang_runtime}" INTERFACE_INCLUDE_DIRECTORIES "${_clang_include}")
    else()
        if(RECAST_HOST_CXX)
            set(_host_compiler "${RECAST_HOST_CXX}")
        else()
            set(_host_compiler "${CMAKE_CXX_COMPILER}")
        endif()
        get_filename_component(_compiler_real "${_host_compiler}" REALPATH)
        get_filename_component(_compiler_bin "${_compiler_real}" DIRECTORY)
        unset(_llvm_config CACHE)
        if(_root)
            find_program(_llvm_config NAMES llvm-config HINTS "${_root}/bin" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
        else()
            set(_llvm_config "")
            foreach(_scope compiler path)
                foreach(_name llvm-config llvm-config-23 llvm-config-22 llvm-config-21 llvm-config-20 llvm-config-19)
                    unset(_candidate CACHE)
                    if(_scope STREQUAL "compiler")
                        find_program(_candidate NAMES "${_name}" PATHS "${_compiler_bin}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
                    else()
                        find_program(_candidate NAMES "${_name}" NO_CMAKE_FIND_ROOT_PATH)
                    endif()
                    if(_candidate)
                        execute_process(COMMAND "${_candidate}" --version OUTPUT_VARIABLE _candidate_version
                            OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _candidate_result)
                        if(_candidate_result EQUAL 0 AND _candidate_version VERSION_GREATER_EQUAL 19)
                            set(_llvm_config "${_candidate}")
                            break()
                        endif()
                    endif()
                endforeach()
                if(_llvm_config)
                    break()
                endif()
            endforeach()
            if(NOT _llvm_config)
                message(FATAL_ERROR "LLVM 19 or newer llvm-config is required")
            endif()
        endif()
        foreach(_query includedir libdir version)
            execute_process(COMMAND "${_llvm_config}" "--${_query}" OUTPUT_VARIABLE "_llvm_${_query}"
                OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
            if(NOT _result EQUAL 0)
                message(FATAL_ERROR "${_llvm_config} --${_query} failed")
            endif()
        endforeach()
        if(_llvm_version VERSION_LESS 19)
            message(FATAL_ERROR "LLVM 19 or newer is required; found ${_llvm_version}")
        endif()
        execute_process(COMMAND "${_llvm_config}" --libs support --system-libs
            OUTPUT_VARIABLE _llvm_link_flags OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "${_llvm_config} could not provide support library link flags")
        endif()
        separate_arguments(_llvm_link_flags NATIVE_COMMAND "${_llvm_link_flags}")
        execute_process(COMMAND "${_llvm_config}" --has-rtti OUTPUT_VARIABLE _llvm_has_rtti
            OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "${_llvm_config} could not report its RTTI setting")
        endif()
        unset(_clang_include CACHE)
        unset(_clang_library CACHE)
        find_path(_clang_include clang-c/Index.h HINTS "${_llvm_includedir}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
        find_library(_clang_library NAMES clang libclang HINTS "${_llvm_libdir}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
        add_library(recast-llvm-support INTERFACE IMPORTED GLOBAL)
        set_property(TARGET recast-llvm-support PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${_llvm_includedir}")
        set_property(TARGET recast-llvm-support PROPERTY INTERFACE_LINK_DIRECTORIES "${_llvm_libdir}")
        set_property(TARGET recast-llvm-support PROPERTY INTERFACE_LINK_LIBRARIES "${_llvm_link_flags}")
        if(_llvm_has_rtti STREQUAL "NO")
            set_property(TARGET recast-llvm-support PROPERTY INTERFACE_COMPILE_OPTIONS "-fno-rtti")
        endif()
        add_library(recast-libclang UNKNOWN IMPORTED GLOBAL)
        set_target_properties(recast-libclang PROPERTIES IMPORTED_LOCATION "${_clang_library}"
            INTERFACE_INCLUDE_DIRECTORIES "${_clang_include}")
    endif()
endfunction()

# LLVM's official Windows development archives use the release MSVC runtime.
# A host tool must use the same C++ runtime ABI even in a Debug project build.
function(recast_configure_llvm_host_tool target)
    if(WIN32)
        set_property(TARGET "${target}" PROPERTY MSVC_RUNTIME_LIBRARY MultiThreaded)
        target_compile_definitions("${target}" PRIVATE _ITERATOR_DEBUG_LEVEL=0)
    endif()
endfunction()
