@PACKAGE_INIT@

set(_recast_include_dir "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set(_recast_lib_dir "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")

if(NOT DEFINED RECAST_LINKAGE OR RECAST_LINKAGE STREQUAL "")
  set(RECAST_LINKAGE SHARED)
endif()
string(TOUPPER "${RECAST_LINKAGE}" _recast_linkage)
if(NOT _recast_linkage MATCHES "^(STATIC|SHARED)$")
  message(FATAL_ERROR "RECAST_LINKAGE must be STATIC or SHARED")
endif()

if(_recast_linkage STREQUAL "STATIC")
  add_library(recast::recast STATIC IMPORTED)
  set_target_properties(recast::recast PROPERTIES
    IMPORTED_LOCATION "${_recast_lib_dir}/@CMAKE_STATIC_LIBRARY_PREFIX@recast-static@CMAKE_STATIC_LIBRARY_SUFFIX@"
    INTERFACE_INCLUDE_DIRECTORIES "${_recast_include_dir}")
else()
  add_library(recast::recast SHARED IMPORTED)
  set_target_properties(recast::recast PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_recast_include_dir}")
  if(WIN32)
    set_target_properties(recast::recast PROPERTIES
      IMPORTED_IMPLIB "${_recast_lib_dir}/recast-shared.lib"
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/recast-shared.dll")
  else()
    set_target_properties(recast::recast PROPERTIES
      IMPORTED_LOCATION "${_recast_lib_dir}/@CMAKE_SHARED_LIBRARY_PREFIX@recast-shared@CMAKE_SHARED_LIBRARY_SUFFIX@")
  endif()
endif()
