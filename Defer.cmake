include_guard(GLOBAL)
set(DEFER_SOURCE_ROOT "${CMAKE_SOURCE_DIR}" CACHE PATH "Root of sources to transform")
set(DEFER_SOURCE_DIRS "." CACHE STRING "Source directories relative to DEFER_SOURCE_ROOT")
set(DEFER_BACKEND "NATIVE" CACHE STRING "Transformer backend")
set(DEFER_HEADER_OVERLAYS "AUTO" CACHE STRING "Header overlays: AUTO, ON, or OFF")
set(DEFER_NATIVE_BINARY "" CACHE FILEPATH "Host defer-tool executable")
set(DEFER_SHARED_CACHE "" CACHE PATH "Shared transformation cache")
set(DEFER_WRAPPER_HEADER_DIRS "" CACHE STRING "Additional wrapper header directories")
set(_DEFER_SCAN_SCRIPT "${CMAKE_BINARY_DIR}/defer-scan.cmake")
file(WRITE "${_DEFER_SCAN_SCRIPT}" [==[
# Run before Ninja decides whether to regenerate its build graph. Change the
# output only when source eligibility changes, so ordinary edits do not rerun
# CMake. Missing files are skipped; normal CMake source discovery handles them.
file(STRINGS "${DEFER_SCAN_INPUT}" _sources ENCODING UTF-8)
file(STRINGS "${DEFER_SCAN_WRAPPERS}" _wrappers ENCODING UTF-8)
list(FILTER _wrappers EXCLUDE REGEX "^$")
list(JOIN _wrappers "|" _alternatives)
set(_pattern "(^|[^A-Za-z0-9_])(${_alternatives}|[A-Za-z_][A-Za-z0-9_]*DEFER[A-Za-z0-9_]*)([^A-Za-z0-9_]|$)")
set(_selected "")
foreach(_source IN LISTS _sources)
    if(NOT EXISTS "${_source}")
        continue()
    endif()
    file(READ "${_source}" _contents)
    string(REGEX REPLACE "\\\\\r?\n" "" _contents "${_contents}")
    if(_contents MATCHES "${_pattern}")
        string(APPEND _selected "${_source}\n")
    endif()
endforeach()
if(EXISTS "${DEFER_SCAN_OUTPUT}")
    file(READ "${DEFER_SCAN_OUTPUT}" _old)
else()
    set(_old "")
endif()
if(NOT EXISTS "${DEFER_SCAN_OUTPUT}" OR NOT _old STREQUAL _selected)
    file(WRITE "${DEFER_SCAN_OUTPUT}" "${_selected}")
endif()

]==])
function(defer_is_source_path out_var relative_path)
    get_filename_component(_source "${DEFER_SOURCE_ROOT}/${relative_path}" ABSOLUTE)
    foreach(_directory IN LISTS DEFER_SOURCE_DIRS)
        get_filename_component(_root "${DEFER_SOURCE_ROOT}/${_directory}" ABSOLUTE)
        cmake_path(IS_PREFIX _root "${_source}" NORMALIZE _inside)
        if(_inside)
            set(${out_var} TRUE PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${out_var} FALSE PARENT_SCOPE)
endfunction()

# Track directory membership while excluding the build tree. A recursive glob
# over the source root would otherwise discover generated overlay headers and
# repeatedly regenerate an in-source-tree build.
function(defer_collect_headers out_var directory is_root allow_build)
    get_filename_component(_directory "${directory}" ABSOLUTE)
    get_filename_component(_name "${_directory}" NAME)
    if(NOT is_root AND _name MATCHES "^(\\.git|\\.hg|\\.svn|\\.venv|venv|__pycache__|node_modules|CMakeFiles)$")
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    get_filename_component(_build "${CMAKE_BINARY_DIR}" ABSOLUTE)
    cmake_path(IS_PREFIX _build "${_directory}" NORMALIZE _inside_build)
    if(is_root AND NOT _inside_build)
        set(allow_build FALSE)
    endif()
    if((_inside_build AND NOT allow_build) OR NOT IS_DIRECTORY "${_directory}")
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    if(UNIX)
        find_program(_defer_find NAMES find)
        if(_defer_find)
            # Discover directories and headers without a CMake filesystem
            # query for every file on a potentially remote source mount.
            # Directory timestamps detect membership changes; header contents
            # are separately registered as configure dependencies below.
            set(_prune \( ! -path "${_directory}" \( -name .git -o -name .hg -o -name .svn
                -o -name .venv -o -name venv -o -name __pycache__ -o -name node_modules -o -name CMakeFiles \) \))
            if(NOT allow_build)
                set(_prune \( ${_prune} -o -path "${_build}" \))
            endif()
            list(APPEND _prune -prune -o)
            execute_process(COMMAND "${_defer_find}" -L "${_directory}" ${_prune} -type d -print
                OUTPUT_VARIABLE _directory_output RESULT_VARIABLE _directory_result ERROR_VARIABLE _directory_error
                OUTPUT_STRIP_TRAILING_WHITESPACE)
            execute_process(COMMAND "${_defer_find}" -L "${_directory}" ${_prune}
                \( -type f -o -type l \) \( -name "*.h" -o -name "*.hpp" -o -name "*.hh"
                -o -name "*.hxx" -o -name "*.inc" -o -name "*.def" -o -name "*.m" -o -name "*.mm" \) -print
                OUTPUT_VARIABLE _header_output RESULT_VARIABLE _header_result ERROR_VARIABLE _header_error
                OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(NOT _directory_result EQUAL 0 OR NOT _header_result EQUAL 0)
                message(FATAL_ERROR "defer header discovery failed: ${_directory_error}${_header_error}")
            endif()
            string(REPLACE "\n" ";" _directories "${_directory_output}")
            string(REPLACE "\n" ";" _headers "${_header_output}")
            if(allow_build AND _directory STREQUAL _build)
                # Do not watch build.ninja's parent timestamp: CMake rewrites
                # files there on regeneration. Track immediate entries by glob.
                list(REMOVE_ITEM _directories "${_build}")
                file(GLOB _build_root_entries CONFIGURE_DEPENDS LIST_DIRECTORIES TRUE "${_build}/*")
            endif()
            set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                ${_directories})
            set(${out_var} "${_headers}" PARENT_SCOPE)
            return()
        endif()
    endif()
    file(GLOB _entries CONFIGURE_DEPENDS LIST_DIRECTORIES TRUE "${_directory}/*")
    set(_headers "")
    foreach(_entry IN LISTS _entries)
        if(IS_DIRECTORY "${_entry}")
            defer_collect_headers(_nested "${_entry}" FALSE "${allow_build}")
            list(APPEND _headers ${_nested})
        elseif(_entry MATCHES "\\.(h|hpp|hh|hxx|inc|def|m|mm)$")
            list(APPEND _headers "${_entry}")
        endif()
    endforeach()
    set(${out_var} "${_headers}" PARENT_SCOPE)
endfunction()
# Detect defer marker or wrapper identifiers in header code, ignoring comments,
# literals, and preprocessor directives. False positives only enable the
# conservative header-overlay build path.
function(defer_header_has_code output content_var wrappers_var)
    set(_content "${${content_var}}")
    set(_wrappers "${${wrappers_var}}")
    list(JOIN _wrappers "|" _alternatives)
    if(NOT _content MATCHES "(^|[^A-Za-z0-9_])(${_alternatives})([^A-Za-z0-9_]|$)")
        set(${output} FALSE PARENT_SCOPE)
        return()
    endif()
    string(REPLACE ";" "\\;" _content "${_content}")
    string(REPLACE "\n" ";" _lines "${_content}")
    set(_in_block FALSE)
    foreach(_line IN LISTS _lines)
        if(NOT _in_block AND _line MATCHES "^[ \t]*#")
            continue()
        endif()
        string(LENGTH "${_line}" _length)
        set(_index 0)
        set(_state code)
        set(_escaped FALSE)
        set(_token "")
        while(_index LESS _length)
            string(SUBSTRING "${_line}" ${_index} 1 _char)
            math(EXPR _next "${_index} + 1")
            set(_next_char "")
            if(_next LESS _length)
                string(SUBSTRING "${_line}" ${_next} 1 _next_char)
            endif()
            if(_in_block)
                if(_char STREQUAL "*" AND _next_char STREQUAL "/")
                    set(_in_block FALSE)
                    math(EXPR _index "${_index} + 2")
                    continue()
                endif()
            elseif(NOT _state STREQUAL code)
                if(_escaped)
                    set(_escaped FALSE)
                elseif(_char STREQUAL "\\")
                    set(_escaped TRUE)
                elseif((_state STREQUAL string AND _char STREQUAL "\"") OR
                       (_state STREQUAL character AND _char STREQUAL "'"))
                    set(_state code)
                endif()
            elseif(_char MATCHES "^[A-Za-z0-9_]$")
                string(APPEND _token "${_char}")
            else()
                if(_token IN_LIST _wrappers)
                    set(${output} TRUE PARENT_SCOPE)
                    return()
                endif()
                set(_token "")
                if(_char STREQUAL "/" AND _next_char STREQUAL "/")
                    break()
                elseif(_char STREQUAL "/" AND _next_char STREQUAL "*")
                    set(_in_block TRUE)
                    math(EXPR _index "${_index} + 2")
                    continue()
                elseif(_char STREQUAL "\"")
                    set(_state string)
                elseif(_char STREQUAL "'")
                    set(_state character)
                endif()
            endif()
            math(EXPR _index "${_index} + 1")
        endwhile()
        if(_token IN_LIST _wrappers)
            set(${output} TRUE PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${output} FALSE PARENT_SCOPE)
endfunction()

function(defer_apply_target target)
    get_property(_header_active GLOBAL PROPERTY DEFER_HEADER_ACTIVE)
    get_target_property(_type "${target}" TYPE)
    if(NOT _type MATCHES "^(OBJECT_LIBRARY|STATIC_LIBRARY|SHARED_LIBRARY|EXECUTABLE)$")
        return()
    endif()
    get_target_property(_sources "${target}" SOURCES)
    get_target_property(_source_dir "${target}" SOURCE_DIR)
    get_target_property(_prerequisites "${target}" MANUALLY_ADDED_DEPENDENCIES)
    if(NOT _sources)
        return()
    endif()
    if(_header_active)
        # A PCH built without the per-source overlay could contain untransformed
        # header functions. Compile each source with its own header overlay.
        set_property(TARGET "${target}" PROPERTY DISABLE_PRECOMPILE_HEADERS TRUE)
    endif()
    set(_new_sources "")
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "\\$<" OR NOT _source MATCHES "\\.(c|m|mm)$")
            list(APPEND _new_sources "${_source}")
            continue()
        endif()
        get_filename_component(_absolute "${_source}" ABSOLUTE BASE_DIR "${_source_dir}")
        file(RELATIVE_PATH _relative "${DEFER_SOURCE_ROOT}" "${_absolute}")
        defer_is_source_path(_eligible "${_relative}")
        if(NOT _eligible OR NOT EXISTS "${_absolute}")
            list(APPEND _new_sources "${_source}")
            continue()
        endif()
        # Makefile generators cannot run the eligibility scan before their
        # build-system check. Keep their existing conservative behavior.
        if(NOT CMAKE_GENERATOR STREQUAL "Ninja")
            set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_absolute}")
        endif()
        if(NOT _absolute IN_LIST _defer_sources)
            list(APPEND _new_sources "${_source}")
            continue()
        endif()
        # Give every translation unit its own output directory. Clang searches
        # the generated file's directory before -iquote; putting generated
        # siblings together can shadow a quoted include from the source tree.
        get_filename_component(_source_name "${_absolute}" NAME)
        set(_generated "${CMAKE_BINARY_DIR}/defer_transformed/${target}/${_relative}.defer/${_source_name}")
        set(_dependency_stamp "${CMAKE_BINARY_DIR}/defer_transformed/${target}/${_relative}.defer.deps")
        set(_header_overlay "${CMAKE_BINARY_DIR}/defer_transformed/${target}/${_relative}.defer.vfs.json")
        set(_transform_input "${_absolute}")
        get_filename_component(_original_dir "${_absolute}" DIRECTORY)
        set(_batch_prerequisites "")
        if(_prerequisites)
            set(_batch_prerequisites ${_prerequisites})
        endif()
        if(DEFER_BACKEND STREQUAL "NATIVE")
            list(SORT _batch_prerequisites)
            string(MD5 _batch_id "${_batch_stage}|${_batch_prerequisites}")
            set_property(GLOBAL APPEND PROPERTY DEFER_BATCH_IDS "${_batch_id}")
            set_property(GLOBAL APPEND PROPERTY "DEFER_${_batch_id}_SOURCES" "${_transform_input}")
            set_property(GLOBAL APPEND PROPERTY "DEFER_${_batch_id}_OUTPUTS" "${_generated}")
            set_property(GLOBAL APPEND PROPERTY "DEFER_${_batch_id}_STAMPS" "${_dependency_stamp}")
            if(_header_active)
                set_property(GLOBAL APPEND PROPERTY "DEFER_${_batch_id}_OVERLAYS" "${_header_overlay}")
            endif()
            set_property(GLOBAL APPEND PROPERTY "DEFER_${_batch_id}_TARGETS" "${target}")
            set_property(GLOBAL PROPERTY "DEFER_${_batch_id}_PREREQUISITES" "${_batch_prerequisites}")
        else()
            file(APPEND "${_plan_records}" "${target}\t${_transform_input}\t${_generated}\t${_batch_prerequisites}\n")
        endif()
        set_source_files_properties("${_generated}" TARGET_DIRECTORY "${target}"
            PROPERTIES GENERATED TRUE SKIP_UNITY_BUILD_INCLUSION TRUE)
        foreach(_property COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FLAGS INCLUDE_DIRECTORIES OBJECT_DEPENDS)
            get_property(_has_property SOURCE "${_absolute}" TARGET_DIRECTORY "${target}" PROPERTY "${_property}" SET)
            if(_has_property)
                get_property(_value SOURCE "${_absolute}" TARGET_DIRECTORY "${target}" PROPERTY "${_property}")
                set_property(SOURCE "${_generated}" TARGET_DIRECTORY "${target}" PROPERTY "${_property}" "${_value}")
            endif()
        endforeach()
        set_property(SOURCE "${_generated}" TARGET_DIRECTORY "${target}" APPEND PROPERTY OBJECT_DEPENDS "${_dependency_stamp}")
        if(CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
            set_property(SOURCE "${_generated}" TARGET_DIRECTORY "${target}" APPEND PROPERTY COMPILE_OPTIONS
                "-clang:-iquote" "-clang:${_original_dir}")
        else()
            set_property(SOURCE "${_generated}" TARGET_DIRECTORY "${target}" APPEND PROPERTY COMPILE_OPTIONS "-iquote" "${_original_dir}")
        endif()
        if(_source MATCHES "\\.m$")
            set_property(SOURCE "${_generated}" TARGET_DIRECTORY "${target}" APPEND PROPERTY COMPILE_OPTIONS "-fobjc-exceptions")
        endif()
        if(_header_active)
            set_property(SOURCE "${_generated}" TARGET_DIRECTORY "${target}" APPEND PROPERTY OBJECT_DEPENDS "${_header_overlay}")
            if(CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
                set_property(SOURCE "${_generated}" TARGET_DIRECTORY "${target}" APPEND PROPERTY COMPILE_OPTIONS
                    "-clang:-ivfsoverlay" "-clang:${_header_overlay}")
            else()
                set_property(SOURCE "${_generated}" TARGET_DIRECTORY "${target}" APPEND PROPERTY COMPILE_OPTIONS "-ivfsoverlay" "${_header_overlay}")
            endif()
        endif()
        list(APPEND _new_sources "${_generated}")
    endforeach()
    set_property(TARGET "${target}" PROPERTY SOURCES "${_new_sources}")
endfunction()

function(defer_finish_batches)
    get_property(_header_active GLOBAL PROPERTY DEFER_HEADER_ACTIVE)
    if(DEFER_BACKEND STREQUAL "NATIVE")
        get_property(_ids GLOBAL PROPERTY DEFER_BATCH_IDS)
        list(REMOVE_DUPLICATES _ids)
        foreach(_id IN LISTS _ids)
            get_property(_sources GLOBAL PROPERTY "DEFER_${_id}_SOURCES")
            get_property(_outputs GLOBAL PROPERTY "DEFER_${_id}_OUTPUTS")
            get_property(_stamps GLOBAL PROPERTY "DEFER_${_id}_STAMPS")
            get_property(_overlays GLOBAL PROPERTY "DEFER_${_id}_OVERLAYS")
            get_property(_targets GLOBAL PROPERTY "DEFER_${_id}_TARGETS")
            get_property(_prerequisites GLOBAL PROPERTY "DEFER_${_id}_PREREQUISITES")
            set(_manifest "${CMAKE_BINARY_DIR}/defer_transformed/batch-${_id}.txt")
            set(_depfile "${CMAKE_BINARY_DIR}/defer_transformed/batch-${_id}.d")
            set(_content "")
            list(LENGTH _sources _count)
            math(EXPR _last "${_count} - 1")
            foreach(_index RANGE ${_last})
                list(GET _sources ${_index} _source)
                list(GET _outputs ${_index} _output)
                string(APPEND _content "${_source}\t${_output}\n")
            endforeach()
            file(GENERATE OUTPUT "${_manifest}" CONTENT "${_content}")
            if(_header_active)
                set(_extra_arguments --header-overlays)
            elseif(DEFER_SHARED_CACHE)
                set(_extra_arguments --shared-cache "${DEFER_SHARED_CACHE}")
            else()
                set(_extra_arguments "")
            endif()
            add_custom_command(OUTPUT ${_outputs} ${_stamps} ${_overlays}
                COMMAND "$<TARGET_FILE:defer-native>" --batch "${_manifest}"
                    --compilation-database "${CMAKE_BINARY_DIR}" --depfile "${_depfile}" --dependency-stamps --incremental
                    ${_extra_arguments}
                DEPENDS ${_sources} "${_manifest}" defer-native "${CMAKE_BINARY_DIR}/compile_commands.json"
                DEPFILE "${_depfile}" COMMENT "Transforming defer source batch" VERBATIM)
            add_custom_target("defer-${_id}" DEPENDS ${_outputs} ${_stamps} ${_overlays})
            if(_prerequisites)
                add_dependencies("defer-${_id}" ${_prerequisites})
            endif()
            list(REMOVE_DUPLICATES _targets)
            foreach(_target IN LISTS _targets)
                add_dependencies("${_target}" "defer-${_id}")
            endforeach()
            foreach(_key SOURCES OUTPUTS STAMPS OVERLAYS TARGETS PREREQUISITES)
                set_property(GLOBAL PROPERTY "DEFER_${_id}_${_key}" "")
            endforeach()
        endforeach()
        set_property(GLOBAL PROPERTY DEFER_BATCH_IDS "")
        return()
    else()
        set(_plan "${CMAKE_BINARY_DIR}/defer-plan-${_batch_stage}.cmake")
            set(_planner "${DEFER_TOOL_ROOT}/python/plan.py")
        set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_planner}")
        if(_header_active)
            set(_planner_options --header-overlays)
        else()
            set(_planner_options "")
        endif()
        execute_process(COMMAND ${DEFER_PYTHON_COMMAND} "${_planner}"
            --records "${_plan_records}" --build-dir "${CMAKE_BINARY_DIR}"
            --stage "${_batch_stage}" --output "${_plan}" ${_planner_options}
            RESULT_VARIABLE _result ERROR_VARIABLE _error ENCODING UTF-8)
    endif()
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "defer batch planning failed: ${_error}")
    endif()
    include("${_plan}")
endfunction()

function(defer_scan_targets out_var)
    get_property(_defer_wrappers GLOBAL PROPERTY DEFER_WRAPPER_NAMES)
    if(NOT _defer_wrappers)
    # Discover wrapper names from project headers, including transitive wrappers.
    # This stays conservative: false positives merely cause a source to be parsed.
    foreach(_directory IN LISTS DEFER_SOURCE_DIRS)
        defer_collect_headers(_directory_headers "${DEFER_SOURCE_ROOT}/${_directory}" TRUE FALSE)
        list(APPEND _defer_headers ${_directory_headers})
    endforeach()
    foreach(_extra_dir IN LISTS DEFER_WRAPPER_HEADER_DIRS)
        file(TO_CMAKE_PATH "${_extra_dir}" _extra_dir)
        if(NOT IS_DIRECTORY "${_extra_dir}")
            message(FATAL_ERROR "defer wrapper header directory does not exist: ${_extra_dir}")
        endif()
        defer_collect_headers(_extra_headers "${_extra_dir}" TRUE TRUE)
        list(APPEND _defer_headers ${_extra_headers})
    endforeach()
    list(REMOVE_DUPLICATES _defer_headers)
    set(_defer_definitions "")
    foreach(_header IN LISTS _defer_headers)
        set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_header}")
        file(READ "${_header}" _header_text)
        string(REPLACE "\r\n" "\n" _header_text "${_header_text}")
        string(REGEX REPLACE "\\\\\n" " " _header_text "${_header_text}")
        string(REPLACE ";" "\\;" _header_text "${_header_text}")
        string(REPLACE "\n" ";" _header_lines "${_header_text}")
        foreach(_line IN LISTS _header_lines)
            if(_line MATCHES "^[ \t]*#[ \t]*define[ \t]+[A-Za-z_][A-Za-z0-9_]*")
                string(REPLACE ";" "\\;" _line "${_line}")
                list(APPEND _defer_definitions "${_line}")
            endif()
        endforeach()
    endforeach()
    set(_defer_wrappers defer defer_named defer_cancel)
    set(_changed TRUE)
    while(_changed)
        set(_changed FALSE)
        foreach(_definition IN LISTS _defer_definitions)
            if(NOT _definition MATCHES "^[ \t]*#[ \t]*define[ \t]+([A-Za-z_][A-Za-z0-9_]*)(.*)$")
                continue()
            endif()
            set(_macro_name "${CMAKE_MATCH_1}")
            set(_macro_body "${CMAKE_MATCH_2}")
            if(_macro_name IN_LIST _defer_wrappers)
                continue()
            endif()
            foreach(_dependency IN LISTS _defer_wrappers)
                if(_macro_body MATCHES "(^|[^A-Za-z0-9_])${_dependency}([^A-Za-z0-9_]|$)")
                    list(APPEND _defer_wrappers "${_macro_name}")
                    set(_changed TRUE)
                    break()
                endif()
            endforeach()
        endforeach()
    endwhile()
    set_property(GLOBAL PROPERTY DEFER_WRAPPER_NAMES "${_defer_wrappers}")
    string(TOUPPER "${DEFER_HEADER_OVERLAYS}" _header_setting)
    if(_header_setting MATCHES "^(ON|TRUE|YES|1)$")
        set(_header_active TRUE)
    elseif(_header_setting MATCHES "^(OFF|FALSE|NO|0)$")
        set(_header_active FALSE)
    elseif(_header_setting STREQUAL "AUTO")
        set(_header_active FALSE)
        foreach(_header IN LISTS _defer_headers)
            file(READ "${_header}" _header_text)
            string(REPLACE "\r\n" "\n" _header_text "${_header_text}")
            string(REGEX REPLACE "\\\\\n" "" _header_text "${_header_text}")
            defer_header_has_code(_header_contains_defer _header_text _defer_wrappers)
            if(_header_contains_defer)
                set(_header_active TRUE)
                message(STATUS "C header defer detected in ${_header}; enabling per-source overlays")
                break()
            endif()
        endforeach()
    else()
        message(FATAL_ERROR "DEFER_HEADER_OVERLAYS must be AUTO, ON, or OFF")
    endif()
    set_property(GLOBAL PROPERTY DEFER_HEADER_ACTIVE "${_header_active}")
    endif()
    set(_scan_files "")
    foreach(_target IN LISTS ARGN)
        get_target_property(_type "${_target}" TYPE)
        if(NOT _type MATCHES "^(OBJECT_LIBRARY|STATIC_LIBRARY|SHARED_LIBRARY|EXECUTABLE)$")
            continue()
        endif()
        get_target_property(_sources "${_target}" SOURCES)
        get_target_property(_source_dir "${_target}" SOURCE_DIR)
        foreach(_source IN LISTS _sources)
            if(_source MATCHES "\\$<" OR NOT _source MATCHES "\\.(c|m|mm)$")
                continue()
            endif()
            get_filename_component(_absolute "${_source}" ABSOLUTE BASE_DIR "${_source_dir}")
            file(RELATIVE_PATH _relative "${DEFER_SOURCE_ROOT}" "${_absolute}")
            defer_is_source_path(_eligible "${_relative}")
            if(_eligible AND EXISTS "${_absolute}")
                list(APPEND _scan_files "${_absolute}")
            endif()
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _scan_files)
    get_property(_header_active GLOBAL PROPERTY DEFER_HEADER_ACTIVE)
    if(_header_active)
        # Experimental correctness-first mode: every eligible C source is
        # analyzed because any of its included headers may contain defer.
        set(${out_var} "${_scan_files}" PARENT_SCOPE)
        return()
    endif()
    set(_scan_input "${CMAKE_BINARY_DIR}/defer-scan-${_batch_stage}.txt")
    string(REPLACE ";" "\n" _scan_content "${_scan_files}")
    file(CONFIGURE OUTPUT "${_scan_input}" CONTENT "${_scan_content}\n" @ONLY)
    set(_wrapper_file "${CMAKE_BINARY_DIR}/defer-wrappers-${_batch_stage}.txt")
    string(REPLACE ";" "\n" _wrapper_content "${_defer_wrappers}")
    file(CONFIGURE OUTPUT "${_wrapper_file}" CONTENT "${_wrapper_content}\n" @ONLY)
    if(CMAKE_GENERATOR STREQUAL "Ninja")
        set(_state "${CMAKE_BINARY_DIR}/defer-eligibility-${_batch_stage}.txt")
        set(_force "${CMAKE_BINARY_DIR}/defer-scan-${_batch_stage}.force")
        set(_scan_command "${CMAKE_COMMAND}"
            "-DDEFER_SCAN_INPUT=${_scan_input}" "-DDEFER_SCAN_WRAPPERS=${_wrapper_file}"
            "-DDEFER_SCAN_OUTPUT=${_state}" -P "${_DEFER_SCAN_SCRIPT}")
        execute_process(COMMAND ${_scan_command} RESULT_VARIABLE _scan_result ERROR_VARIABLE _scan_error)
        if(NOT _scan_result EQUAL 0)
            message(FATAL_ERROR "defer source scan failed: ${_scan_error}")
        endif()
        set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${_state}" "${_DEFER_SCAN_SCRIPT}")
        # Ninja evaluates build.ninja dependencies before compiling. The
        # symbolic input makes the scan run even on no-op builds, while restat
        # prevents reconfiguration if eligibility is unchanged.
        set_source_files_properties("${_force}" PROPERTIES SYMBOLIC TRUE)
        add_custom_command(OUTPUT "${_force}" COMMAND "${CMAKE_COMMAND}" -E true VERBATIM)
        add_custom_command(OUTPUT "${_state}" COMMAND ${_scan_command}
            DEPENDS "${_force}" "${_scan_input}" "${_wrapper_file}" "${_DEFER_SCAN_SCRIPT}"
            COMMENT "Checking defer source eligibility" VERBATIM)
        add_custom_target("defer-scan-${_batch_stage}" DEPENDS "${_state}")
        file(STRINGS "${_state}" _scan_output ENCODING UTF-8)
        set(${out_var} "${_scan_output}" PARENT_SCOPE)
        return()
    endif()
    if(DEFER_BACKEND STREQUAL "NATIVE")
        set(_defer_sources "")
        foreach(_source IN LISTS _scan_files)
            file(READ "${_source}" _contents)
            string(REGEX REPLACE "\\\\\r?\n" "" _contents "${_contents}")
            foreach(_wrapper IN LISTS _defer_wrappers)
                if(_contents MATCHES "(^|[^a-zA-Z0-9_])${_wrapper}([^a-zA-Z0-9_]|$)")
                    list(APPEND _defer_sources "${_source}")
                    break()
                endif()
            endforeach()
        endforeach()
        set(${out_var} "${_defer_sources}" PARENT_SCOPE)
        return()
    else()
        set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${DEFER_TOOL_ROOT}/python/scan.py")
        execute_process(COMMAND ${DEFER_PYTHON_COMMAND} "${DEFER_TOOL_ROOT}/python/scan.py" "${_wrapper_file}"
            ENCODING UTF-8 INPUT_FILE "${_scan_input}" OUTPUT_VARIABLE _scan_output ERROR_VARIABLE _scan_error RESULT_VARIABLE _scan_result
            OUTPUT_STRIP_TRAILING_WHITESPACE)
    endif()
    if(NOT _scan_result EQUAL 0)
        message(FATAL_ERROR "defer source scan failed: ${_scan_error}")
    endif()
    string(REPLACE "\n" ";" _scan_output "${_scan_output}")
    set(${out_var} "${_scan_output}" PARENT_SCOPE)
endfunction()


# Call after adding all targets in this batch. CMake must export its compilation database.
function(defer_targets)
  if(NOT CMAKE_EXPORT_COMPILE_COMMANDS)
    message(FATAL_ERROR "defer_targets requires CMAKE_EXPORT_COMPILE_COMMANDS=ON")
  endif()
  if(NOT CMAKE_GENERATOR MATCHES "^(Ninja|Unix Makefiles)$")
    message(FATAL_ERROR "defer_targets requires single-config Ninja or Unix Makefiles")
  endif()
  if(DEFER_BACKEND STREQUAL "NATIVE")
    if(NOT DEFER_NATIVE_BINARY)
      find_program(DEFER_NATIVE_BINARY NAMES defer-tool REQUIRED)
    endif()
    if(NOT TARGET defer-native)
      add_executable(defer-native IMPORTED GLOBAL)
      set_property(TARGET defer-native PROPERTY IMPORTED_LOCATION "${DEFER_NATIVE_BINARY}")
    endif()
  elseif(DEFER_BACKEND STREQUAL "PYTHON")
    if(NOT EXISTS "${DEFER_TOOL_ROOT}/python/defer.py")
      message(FATAL_ERROR "Set DEFER_TOOL_ROOT to a defer checkout for the Python backend")
    endif()
    if(NOT DEFER_PYTHON_COMMAND)
      find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
      set(DEFER_PYTHON_COMMAND "${Python3_EXECUTABLE}")
    endif()
    if(NOT DEFER_LIBCLANG_PATH AND DEFINED ENV{LIBCLANG_LIBRARY_FILE})
      set(DEFER_LIBCLANG_PATH "$ENV{LIBCLANG_LIBRARY_FILE}")
    endif()
    if(NOT EXISTS "${DEFER_LIBCLANG_PATH}")
      message(FATAL_ERROR "Set DEFER_LIBCLANG_PATH to the libclang shared library")
    endif()
  else()
    message(FATAL_ERROR "DEFER_BACKEND must be NATIVE or PYTHON")
  endif()
  string(SHA256 _batch_stage "${CMAKE_CURRENT_SOURCE_DIR};${ARGN}")
  set(_plan_records "${CMAKE_BINARY_DIR}/defer-records-${_batch_stage}.txt")
  file(WRITE "${_plan_records}" "")
  defer_scan_targets(_defer_sources ${ARGN})
  foreach(_target IN LISTS ARGN)
    defer_apply_target("${_target}")
  endforeach()
  defer_finish_batches()
endfunction()
function(defer_target target)
  defer_targets("${target}")
endfunction()
